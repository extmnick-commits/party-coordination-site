rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /hero/background {
      allow write: if request.auth != null;
      allow read: if true;
    }

    match /gallery/{allFiles=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /recent-event/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
